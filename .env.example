# =============================================================================
# CMO² — Environment variables & API keys (reference / template)
# =============================================================================
# Copy to `.env` and fill in real values for local non-Docker runs:
#     cp .env.example .env
# Backend (Spring): export these, or pass them via docker-compose / Docker secrets.
# Frontend (Vite): only VITE_* vars are read, from cmo2-frontend/.env.local.
#
# Legend:  [REQUIRED] must be set in any shared/prod env (dev defaults exist for local)
#          [ACTIVE]   consumed by the code TODAY (Phases 0–3)
#          [FUTURE]   not wired yet — placeholder hint for the phase that adds it
# =============================================================================

# ---- Database (MySQL) ------------------------------------------------ [ACTIVE]
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cmo2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=cmo2
SPRING_DATASOURCE_PASSWORD=cmo2pw

# ---- Redis ----------------------------------------------------------- [ACTIVE]
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ---- Mail (local: Mailhog) ------------------------------------------- [ACTIVE]
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# ---- Security secrets ------------------------------------ [ACTIVE][REQUIRED] --
# JWT signing key — use a long random string (64+ chars / 256+ bits).
#   generate: openssl rand -base64 64
CMO2_JWT_SECRET=change-me-to-a-long-random-string-at-least-64-bytes-please-rotate

# AES-256-GCM master key — must be Base64 of EXACTLY 32 bytes.
#   generate: openssl rand -base64 32
CMO2_CRYPTO_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ---- CORS / frontend origin ------------------------------------------ [ACTIVE]
CMO2_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Strange Loop engine tuning (Phase 2) ---------------------------- [ACTIVE]
CMO2_LOOP_STAGE_DELAY_MS=600         # pause between stages so live progress is visible; 0 in prod
# Each customer's cycle schedule (daily/weekly/monthly) is set on its customer page and kept by Quartz.
CMO2_AI_INTERACTION_RETENTION_DAYS=180   # every AI prompt/response is kept this long, then deleted
CMO2_AI_COMPANY_MONTHLY_TOKEN_CEILING=2000000   # per-customer monthly AI cap (0 = none)

# ---- Integrations: sync sweep (Phase 3) ------------------------------ [ACTIVE]
CMO2_SYNC_INTERVAL_MS=60000
CMO2_SYNC_INITIAL_DELAY_MS=20000

# ---- GoHighLevel connector (Phase 3) --------------------------------- [ACTIVE]
# Demo mode returns realistic simulated KPIs so the pipeline runs with no real account.
CMO2_GHL_DEMO_MODE=true
CMO2_GHL_BASE_URL=https://services.leadconnectorhq.com
# Set false above + provide the real key in the Integrations UI for live data.
# Inbound GHL webhooks are verified with GHL's published Ed25519 public key (built-in default).
# Override only if GHL rotates the key before a redeploy:
# CMO2_GHL_WEBHOOK_PUBLIC_KEY=

# ---- GoHighLevel agency OAuth (your Marketplace app; needs Agency Pro) ---------------
# Create the app at marketplace.gohighlevel.com with "Who can install" = Agency, then:
CMO2_GHL_CLIENT_ID=
CMO2_GHL_CLIENT_SECRET=
# Advanced Settings > Auth > Installation URL ("Show"):
CMO2_GHL_INSTALL_URL=
# Must equal the redirect URL registered on the app (the CMO² page that finishes the install):
CMO2_GHL_REDIRECT_URI=http://localhost:5173/settings/ghl/callback
# Your agency's GHL company id — when set, installs from any other agency are refused:
CMO2_GHL_AGENCY_COMPANY_ID=
# Scopes to enable on the app: locations.readonly contacts.readonly contacts.write
#   opportunities.readonly payments/transactions.readonly calendars.readonly
#   calendars/events.readonly conversations.readonly users.readonly
#   locations/customValues.readonly locations/customValues.write
#   socialplanner/account.readonly socialplanner/post.write oauth.readonly oauth.write
# (users.readonly: a social post must name the sub-account user it's posted as.)

# ---- Owner console access -----------------------------------------------------------
# first-user-only (default): only the first sign-up is allowed; invite everyone else.
CMO2_SELF_REGISTRATION=first-user-only

# ---- AI: Claude + OpenAI (Phases 4-6) -------------------------------- [ACTIVE]
# 'stub' = realistic demo content, no key needed. 'anthropic' = live routing:
#   strategy (cycle plans, strategists) -> Claude;
#   generation + translation -> OpenAI when CMO2_AI_OPENAI_API_KEY is set, else Claude.
CMO2_AI_PROVIDER=stub
# Override one tier if you like (anthropic | openai | stub); blank = the routing above:
CMO2_AI_ROUTE_STRATEGY=
CMO2_AI_ROUTE_GENERATION=
CMO2_AI_ROUTE_TRANSLATION=
# Claude (falls back to ANTHROPIC_API_KEY below) and its per-tier models:
CMO2_AI_API_KEY=
CMO2_AI_MODEL_STRATEGY=claude-opus-5-5
CMO2_AI_MODEL_GENERATION=claude-opus-5-5
CMO2_AI_MODEL_TRANSLATION=claude-haiku-5-5
CMO2_AI_ANTHROPIC_REFUSAL_FALLBACK=true   # API retries a declined request on another model (beta)
# OpenAI (falls back to OPENAI_API_KEY below) and its per-tier models — check these names against
# your OpenAI account before going live:
CMO2_AI_OPENAI_API_KEY=
CMO2_AI_OPENAI_MODEL_STRATEGY=gpt-5
CMO2_AI_OPENAI_MODEL_GENERATION=gpt-5
CMO2_AI_OPENAI_MODEL_TRANSLATION=gpt-5-mini
# Stage 1 drafts per cycle (0 = plan only) and the most drafts allowed to wait for approval:
CMO2_LOOP_DRAFTS_PER_CYCLE=1
CMO2_LOOP_MAX_PENDING_DRAFTS=3
# Stage 5 experiments: most waiting for your decision, days before measuring, and whether custom value
# changes may run without your approval (they feed live GHL workflows/emails, so default false):
CMO2_LOOP_MAX_OPEN_EXPERIMENTS=3
CMO2_LOOP_EXPERIMENT_MEASURE_AFTER_DAYS=3
CMO2_LOOP_AUTO_APPLY_REVERSIBLE=false

# ---- Alerts engine (Phase 6) ----------------------------------------- [ACTIVE]
# The rule sweep runs continuously so a breach fires well within the 5-minute target.
CMO2_ALERTS_EVAL_INTERVAL_MS=60000
CMO2_ALERTS_EVAL_INITIAL_DELAY_MS=30000
# Optional global Slack incoming-webhook for alert delivery. Blank = log intent only
# (a per-rule SLACK channel target URL overrides this). Email alerts use the Mail config above.
CMO2_ALERTS_SLACK_WEBHOOK_URL=

# ---- Reports scheduler (Phase 6) ------------------------------------- [ACTIVE]
# A portfolio PDF is generated for every tenant on this cadence and lands in the Reports module.
CMO2_REPORTS_WEEKLY_INTERVAL_MS=604800000      # 7 days
CMO2_REPORTS_WEEKLY_INITIAL_DELAY_MS=3600000   # 1 hour after startup

# ---- Workspace tools (Notion / Confluence / Linear / Slack) --------- [ACTIVE]
# Not configured here: connect them in CMO² → Settings → Workspace tools. Tokens are stored
# encrypted per agency, and each customer gets its own page/project in your workspaces.

# ---- Billing / Stripe (Phase 7) -------------------------------------- [ACTIVE]
# 'stub' = the full signup -> pay -> use flow runs with NO Stripe account (demo checkout
# activates the plan instantly). Set 'stripe' + the keys/price-ids for real hosted Checkout,
# Customer Portal, and webhooks.
CMO2_BILLING_PROVIDER=stub
CMO2_BILLING_STRIPE_SECRET_KEY=          # sk_test_... / sk_live_... (only when provider=stripe)
CMO2_BILLING_STRIPE_WEBHOOK_SECRET=      # whsec_... — verifies inbound Stripe webhooks
CMO2_BILLING_TRIAL_DAYS=14
# Browser return URLs after Checkout / Portal (frontend routes):
CMO2_BILLING_SUCCESS_URL=http://localhost:5173/billing?checkout=success
CMO2_BILLING_CANCEL_URL=http://localhost:5173/billing?checkout=cancel
CMO2_BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing
# Stripe Price IDs per plan (create products/prices in the Stripe dashboard):
CMO2_BILLING_PRICE_STARTER=              # price_...
CMO2_BILLING_PRICE_PRO=                  # price_...
CMO2_BILLING_PRICE_ENTERPRISE=           # price_...

# ---- Rate limiting (Phase 7) ----------------------------------------- [ACTIVE]
# Per-tenant / per-IP token bucket. Tune or disable (e.g. for load tests).
CMO2_RATELIMIT_ENABLED=true
CMO2_RATELIMIT_CAPACITY=240              # burst size
CMO2_RATELIMIT_REFILL_PER_MINUTE=240

# ---- Frontend (cmo2-frontend/.env.local) ----------------------------- [ACTIVE]
VITE_API_BASE_URL=http://localhost:8080

# =============================================================================
# External service API keys — NOT consumed yet; hints for upcoming phases.
# Add the real values when you reach the phase that wires them in.
# =============================================================================

# ---- AI providers (Phase 4–5: AiService, asset generation, strategists) [FUTURE]
ANTHROPIC_API_KEY=sk-ant-...        # Claude — strategy/reasoning tier (ACTIVE since Phase 6)
OPENAI_API_KEY=sk-...               # OpenAI — content + EN→ES translation tier (ACTIVE since Phase 6)

# ---- Email / SMS transport providers (Phase 6 alerts) --------------- [FUTURE]
# Phase 6 sends email via the Spring Mail config above (Mailhog locally) and Slack via
# CMO2_ALERTS_SLACK_WEBHOOK_URL above. These swap that transport for hosted providers
# (SES/SendGrid for email at scale, Twilio for real SMS) in hardening.
SENDGRID_API_KEY=SG....             # or AWS SES creds below
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
TWILIO_ACCOUNT_SID=AC...            # real SMS alerts (Phase 6 logs SMS intent for now)
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

# ---- Billing / Stripe (Phase 7) ----------------------- see CMO2_BILLING_* above [ACTIVE]
# The CMO2_BILLING_* block above is what the app reads (secret key, webhook secret, price ids).
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET are accepted as fallbacks. The publishable key is
# only needed if you build a custom client-side checkout (the hosted flow doesn't require it).
STRIPE_PUBLISHABLE_KEY=pk_test_...
